/// @title IGroth16Verifier
/// Author Rushidev Gajanan Ukalkar
/// @notice Standard interface auto generated by snarkjs or the libsnark's Solidity
/// exporter for the Keyexchangecircuit.. Performs the 3 pairing
///  Groth16 check on the ether block chain against the alt_bn128 precompiles
///                       (ecAdd/ ecMul /ecPairing at 0x06/0x07 / 0x08)  some offset
interface IGroth16Verifier {
    function verifyProof(
        uint256[2] calldata a,       
        uint256[2][2] calldata b,
        uint256[2] calldata c,
        uint256[7] calldata publicInputs //format would be like a list that will get both parties' along with thier public keys both components in x & y + what oprator +...   [commitment ,issuerPkX, issuerPkY, bobPkX ,bobPkY ,cipherC1, cipherC2]
    ) external view returns (bool);
}

/// @title Zero Knowledge Proof Credential Escrow
/// @notice Trustless fair  exchange for issuer signed digital credentials
///
/// My Design principle : person A never sends anything to B after payment..
/// and that is where trust is playing a role. this gross will do No-Trust Barter
/// She publishes the El Gamal ciphertext of the key UP FRONT & proves
/// in zero knowledge that [1] Firstly it decrypts to a key matching her public
/// commitment &[2ndly] that key carries a valid signature from a trusted
/// issuer. B only releases funds once the on chain proof check passes
/// and decryption happens entirely off chain on his side with his own
/// private key. dispute period needed? idk yet but oracal isn't + reaveal as well (no)
/// 
/// reminder to implement niche idea of Non Intractive zero knowledge proof later
/// 
/// contract ==> boilerplate & inits ==> an unchangable id to verify.
///
contract ZKCredentialEscrow {
    IGroth16Verifier public immutable verifier;

    enum State { AwaitingDeposit, Funded, Settled, Refunded }

    // lets assume Alice (prover) and Bob (verifier)are doing this in this story.

    struct Trade {
        address alice;
        address bob;
        uint256 price;
        uint256 deadline;//Bob's funds are refundable after this if Alice never proves
        uint256 commitment;//Poseidon (key),public  made in c++
        uint256[2] issuerPk;
        uint256[2] bobPk;
        uint256[2] ciphertext;  //ElGamal(bob_pk, key) Bob decrypts this locally post settlement
        State state;
    }

    mapping(uint256 => Trade) public trades;
    uint256 public nextTradeId;

    event TradeOpened(uint256 indexed tradeId, address indexed alice, address indexed bob, uint256 price);
    event Funded(uint256 indexed tradeId);
    event Settled(uint256 indexed tradeId);
    event Refunded(uint256 indexed tradeId);

    constructor(address verifierAddress) {
        verifier = IGroth16Verifier(verifierAddress);
    }

    

    /// just before and after making a position and def funks
    /// @notice Alice opens a trade by publishing her commitment + ciphertext
    ///         BEFORE any funds move this is the piece that makes the
    ///         exchange atomic: Bob can verify off chain that the public
    ///         data looks right before ever depositing a cent.
    function openTrade(
        address bob,
        uint256 price,
        uint256 commitment,
        uint256[2] calldata issuerPk,
        uint256[2] calldata bobPk,
        uint256[2] calldata ciphertext,
        uint256 fundingWindow
    ) external returns (uint256 tradeId) {
        tradeId = nextTradeId++;
        trades[tradeId] = Trade({
            alice: msg.sender,
            bob: bob,
            price: price,
            deadline: block.timestamp + fundingWindow,
            commitment: commitment,
            issuerPk: issuerPk,
            bobPk: bobPk,
            ciphertext: ciphertext,
            state: State.AwaitingDeposit
        });
        emit TradeOpened(tradeId, msg.sender, bob, price);
    }

    /// i need to drop this non-intractive ZPiK wala thought.  both should
    /// come online to settle this deal BEFORE deadline or it reverts to..
    /// @notice Bob deposits the agreed price into escrow. Funds are now
    ///         locked and can only leave via a valid ZK proof (to Alice)
    ///         or a timeout (back to Bob) never by either party alone
    function fund(uint256 tradeId) external payable {
        Trade storage t = trades[tradeId];
        require(msg.sender==t.bob, "only designated buyer");
        require(t.state==State.AwaitingDeposit, "wrong state");
        require(msg.value==t.price, "incorrect amount");
        require(block.timestamp <= t.deadline, "funding window closed");

        t.state = State.Funded;
        emit Funded(tradeId);
    }

    /// @notice Alice settles the trade by submitting their Groth16 proof
    ///         On success, funds move to Alice atomically in the same
    ///         transaction that verifies she holds a genuine actual 
    ///         issuer signed credential matching the already published cipher's text
    function settle( //can later use this on fund funk
        uint256 tradeId,           //flaged
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c
    ) external {
        Trade storage t = trades[tradeId];
        require(msg.sender==t.alice, "only seller may settle");
        require(t.state==State.Funded, "not funded");

        //new int format would be like a vetor that will get both parties' along with 
        //thier public keys both components in x & y + what oprator +...   
        //commitment and issuerPkX&PkY and bobPkX&PkY and the cipherC1&C2
        uint256[7] memory publicInputs = [
            t.commitment,
            t.issuerPk[0], t.issuerPk[1],
            t.bobPk[0], t.bobPk[1],
            t.ciphertext[0], t.ciphertext[1]
        ];

        bool valid = verifier.verifyProof(a, b, c, publicInputs);
        require(valid, "invalid proof: key/signature/ciphertext mismatch");

        t.state = State.Settled;
        emit Settled(tradeId);

        (bool sent, ) = t.alice.call{value: t.price}("");
        require(sent, "payout failed");
        // Bob already has ciphertext on block chain and decrypts it locally
        // with his own private key no further action needed here... however,
    }

    // Dismiss  ==> reverting actions
    /// @notice If Alice never produces a valid proof before the deadline
    ///         Bob reclaims his funds. This is what makes the protocol
    ///         safe for Bob to fund first: worst case is a timeout, not
    ///         a loss
    ///         Still there's a very very small chance that bob's verification
    ///         may be false..   is there anythong stronger than .zk  
    ///         in next version i will use rsi/ris whatever

    function refund(uint256 tradeId) external {
        Trade storage t = trades[tradeId];

        require(msg.sender ==t.bob, "only buyer");
        require(t.state ==State.Funded, "not funded");
        require(block.timestamp > t.deadline, "deadline not reached");

        t.state = State.Refunded;
        emit Refunded(tradeId);

        (bool sent, ) = t.bob.call{value: t.price}("");
        require(sent, "refund failed");


    }

}
